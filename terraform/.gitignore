# Terraform .gitignore
# Feature: 003-ec2-alb-nginx

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock file (optional - some teams commit this)
# .terraform.lock.hcl

# Ignore any local test files
*.test
*.tmp

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.*

# Local terraform provider cache
.terraform.d/

# Documentation build artifacts
docs/_build/

# Temporary files
*.bak
*.orig
*.backup
