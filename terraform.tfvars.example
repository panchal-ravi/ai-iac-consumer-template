# Example Terraform Variables
# Feature: 001-public-ec2-password-auth
#
# SECURITY WARNING: This is a development-only configuration
# Copy this file to terraform.tfvars and update values
# DO NOT commit terraform.tfvars to version control

# ===================================================================
# AWS Configuration
# ===================================================================

aws_region = "ap-southeast-1"  # Fixed to Singapore
environment = "dev"             # Options: dev, staging, prod

# ===================================================================
# EC2 Instance Configuration
# ===================================================================

instance_type      = "t3.micro"  # Fixed for cost optimization
root_volume_size   = 8           # Range: 8-20 GB

# ===================================================================
# Network Configuration (Optional)
# ===================================================================

# Enable HTTP access (port 80) - default: false
enable_http  = false

# Enable HTTPS access (port 443) - default: false
enable_https = false

# ===================================================================
# CloudWatch Configuration
# ===================================================================

cloudwatch_log_retention_days = 7  # Minimum: 7 days

# ===================================================================
# Security Notes
# ===================================================================
#
# Password is auto-generated by Terraform (20 characters)
# Retrieved via: terraform output -json instance_password | jq -r '.[]'
# Stored as sensitive output in HCP Terraform workspace
#
# SSH Access: devuser@<public-ip>
# Security Group: SSH port 22 from 0.0.0.0/0 (development only)
#
# For production use:
# - Switch to SSH key-based authentication
# - Restrict SSH to specific IP ranges
# - Implement AWS Systems Manager Session Manager
# - Add fail2ban or intrusion detection
#
# ===================================================================
